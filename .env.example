# Local database only; change credentials before any hosted deployment.
POSTGRES_USER=applytrack
POSTGRES_PASSWORD=applytrack
POSTGRES_DB=applytrack
# Host port; container connections always use db:5432.
POSTGRES_PORT=55432
DATABASE_URL=postgresql+psycopg://applytrack:applytrack@localhost:55432/applytrack
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# UUID of the sole allowed Supabase user
OWNER_ID=
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional Gmail integration — SERVER ONLY. Leave empty to keep Gmail disabled.
# Create a Google OAuth Web application; register the exact callback URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Fernet key: backend/.venv/bin/python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Keep this key stable and backed up separately; losing it makes tokens unreadable.
GMAIL_ENCRYPTION_KEY=
GMAIL_REDIRECT_URI=http://localhost:8000/api/gmail/oauth/callback
GMAIL_FRONTEND_URL=http://localhost:5173

# Production runtime only (see docs/DEPLOYMENT.md); keep development locally.
APP_ENV=development
APP_ORIGIN=
STATIC_DIR=
# Optional direct PostgreSQL URL for Alembic; required TLS in production.
MIGRATION_DATABASE_URL=
# Trust only your ingress proxy. Render-only configuration is explained in docs.
FORWARDED_ALLOW_IPS=127.0.0.1
